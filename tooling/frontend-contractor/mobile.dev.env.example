# Copy to frontend_mobile/.env; NEVER commit .env or production credentials.
# Request the correct API and WebSocket origins from the ChemistTasker owner.
EXPO_PUBLIC_API_URL=https://YOUR-ISOLATED-STAGING-HOST/api/v1
EXPO_PUBLIC_WS_URL=wss://YOUR-ISOLATED-STAGING-HOST
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# Development ONLY. Production release requirements remain with the owner.
EXPO_PUBLIC_SSL_PINNING_ENABLED=false
