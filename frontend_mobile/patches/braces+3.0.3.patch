diff --git a/node_modules/braces/lib/validate-depth.js b/node_modules/braces/lib/validate-depth.js
new file mode 100644
index 0000000..5ed7774
--- /dev/null
+++ b/node_modules/braces/lib/validate-depth.js
@@ -0,0 +1,26 @@
+'use strict';
+
+// Public walkers also accept caller-created ASTs, so parser checks alone
+// cannot enforce a safe recursion bound. Ignore parent/prev back references.
+module.exports = ast => {
+  const active = new Set();
+  const pending = [{ node: ast, depth: 0 }];
+  while (pending.length) {
+    const item = pending.pop();
+    if (item.leave) {
+      active.delete(item.node);
+      continue;
+    }
+    if (!item.node || typeof item.node !== 'object') continue;
+    if (item.depth > 64 || active.has(item.node)) {
+      throw new SyntaxError('Brace AST nesting exceeds 64 levels or contains a cycle');
+    }
+    active.add(item.node);
+    pending.push({ node: item.node, leave: true });
+    if (Array.isArray(item.node.nodes)) {
+      for (let i = item.node.nodes.length - 1; i >= 0; i--) {
+        pending.push({ node: item.node.nodes[i], depth: item.depth + 1 });
+      }
+    }
+  }
+};
