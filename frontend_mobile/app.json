{
  "expo": {
    "name": "ChemistTasker",
    "slug": "chemisttasker",
    "version": "1.0.11",
    "orientation": "default",
    "icon": "./assets/images/ChatGPT Image Jan 18, 2026, 08_14_43 PM.png",
    "scheme": "frontendmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": "1.0.11",
    "updates": {
      "url": "https://u.expo.dev/75fa2fa5-e9ed-47af-a012-86967b951c5b",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chemisttasker.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow camera access to add profile photos.",
        "NSLocationWhenInUseUsageDescription": "Allow location access while using the app to improve map-based address selection and travel radius preview.",
        "NSPhotoLibraryUsageDescription": "Allow photo library access to upload profile photos and attachments.",
        "NSPhotoLibraryAddUsageDescription": "Allow saving images to your photo library.",
        "NSFaceIDUsageDescription": "Use Face ID to sign in to ChemistTasker.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": []
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ChatGPT Image Jan 18, 2026, 08_14_43 PM.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.chemisttasker.app",
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidManifestFixes",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ChatGPT Image Jan 18, 2026, 08_14_43 PM.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to sign in to ChemistTasker."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "useModularHeaders": true,
            "buildReactNativeFromSource": true,
            "extraPods": [],
            "flipper": false,
            "deploymentTarget": "15.1"
          }
        }
      ],
      "./plugins/withIosNonModularHeaders"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "75fa2fa5-e9ed-47af-a012-86967b951c5b"
      }
    }
  }
}
