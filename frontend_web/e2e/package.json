    "e2e:mcp": "node run-e2e.mjs mcp"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "e2e": "0.18.0",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0"
  }
}
