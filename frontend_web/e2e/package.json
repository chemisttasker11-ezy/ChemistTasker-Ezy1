{
  "name": "@chemisttasker/frontend-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node run-tests.mjs",
    "test:e2e": "node run-e2e.mjs run",
    "test:e2e:authenticated": "node run-e2e.mjs run-authenticated",
    "typecheck:e2e": "node ../node_modules/typescript/bin/tsc --project tsconfig.json",
    "e2e:list": "node run-e2e.mjs list",
