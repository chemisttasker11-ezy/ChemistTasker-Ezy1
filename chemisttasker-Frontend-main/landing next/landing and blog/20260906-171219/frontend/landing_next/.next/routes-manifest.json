    },
    {
      "page": "/reset-password/[uid]/[token]",
      "regex": "^/reset\\-password/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPuid": "nxtPuid",
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/reset\\-password/(?<nxtPuid>[^/]+?)/(?<nxtPtoken>[^/]+?)(?:/)?$"
    }
  ],
