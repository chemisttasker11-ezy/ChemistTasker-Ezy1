    },
    {
      "page": "/onboarding/referee-reject/[pk]/[refIndex]",
      "regex": "^/onboarding/referee\\-reject/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPpk": "nxtPpk",
        "nxtPrefIndex": "nxtPrefIndex"
      },
      "namedRegex": "^/onboarding/referee\\-reject/(?<nxtPpk>[^/]+?)/(?<nxtPrefIndex>[^/]+?)(?:/)?$"
    },
    {
      "page": "/organization/[slug]",
